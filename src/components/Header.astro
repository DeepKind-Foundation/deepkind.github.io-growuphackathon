<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-block: var(--space-3);
    background: color-mix(in oklch, var(--c-paper) 70%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: background 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .site-header[data-scrolled='true'] {
    background: color-mix(in oklch, var(--c-paper) 92%, transparent);
    border-bottom-color: var(--c-rule);
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    transition: opacity 0.2s var(--ease-out);
  }
  .site-header__logo:hover { opacity: 0.78; }

  .site-header__mark {
    height: 36px;
    width: auto;
    flex-shrink: 0;
  }

  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--c-ink);
  }
  .site-header__wordmark em {
    font-style: normal;
    color: var(--c-yellow);
  }

  .site-header__menu {
    display: none;
    gap: var(--space-8);
    align-items: center;
  }
  .site-header__menu a {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-2);
    transition: color 0.15s var(--ease-out);
  }
  .site-header__menu a:hover { color: var(--c-yellow); }

  @media (min-width: 1024px) {
    .site-header__menu { display: flex; }
    .site-header__mark { height: 44px; }
    .site-header__wordmark { font-size: 1.6rem; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => { header.dataset.scrolled = window.scrollY > 40 ? 'true' : 'false'; };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
