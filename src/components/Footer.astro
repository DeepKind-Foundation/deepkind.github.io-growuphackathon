---
import type { HomeContent } from '../lib/types';
import { safeHref } from '../lib/url';

interface Props {
  footer: HomeContent['footer'];
  links: HomeContent['links'];
}

const { footer, links } = Astro.props;
---

<footer id="kontakt" class="footer">
  <div class="container container--md footer__inner">
    <div class="footer__top">
      <h2 class="footer__contact-title">{footer.contactTitle}</h2>
      <a class="footer__email" href={safeHref(`mailto:${links.contactEmail}`)}>
        <i class="ph-bold ph-envelope" aria-hidden="true"></i>
        {links.contactEmail}
      </a>
    </div>

    <div class="footer__social">
      <a
        href={safeHref(links.instagram)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="footer__social-link"
      >
        <i class="ph-fill ph-instagram-logo" aria-hidden="true"></i>
        Instagram
      </a>
      <a
        href={safeHref(links.facebook)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="footer__social-link"
      >
        <i class="ph-fill ph-facebook-logo" aria-hidden="true"></i>
        Facebook
      </a>
    </div>

    <div class="footer__rule" aria-hidden="true"></div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <a href={safeHref(links.regulamin)} target="_blank" rel="noopener noreferrer">Regulamin</a>
        <a href={safeHref(links.privacy)} target="_blank" rel="noopener noreferrer">
          Polityka Prywatności
        </a>
      </div>
      <p class="footer__copyright">{footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--c-rule);
    padding-block: var(--space-12) var(--space-8);
    padding-inline: var(--space-4);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__contact-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--c-ink);
  }

  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--c-ink-2);
    transition: color 0.15s var(--ease-out);
  }
  .footer__email:hover { color: var(--c-red); }

  .footer__social {
    display: flex;
    gap: var(--space-6);
  }
  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    transition: color 0.15s var(--ease-out);
  }
  .footer__social-link:hover { color: var(--c-ink); }

  .footer__rule {
    height: 1px;
    background: var(--c-rule);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__legal {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .footer__legal a {
    font-family: var(--font-body);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s var(--ease-out);
  }
  .footer__legal a:hover { color: var(--c-ink); }

  .footer__copyright {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-rule);
  }

  @media (min-width: 768px) {
    .footer__top {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
    }
    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
