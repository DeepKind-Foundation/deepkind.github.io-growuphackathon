---
interface Props {
  opacity?: number;
}
const { opacity = 0.08 } = Astro.props;
---
<svg class="section-noise" aria-hidden="true" focusable="false">
  <rect width="100%" height="100%" filter="url(#paper-noise)" />
</svg>

<style define:vars={{ noiseOp: opacity }}>
  .section-noise {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: var(--noiseOp);
    z-index: -1;
  }
</style>
