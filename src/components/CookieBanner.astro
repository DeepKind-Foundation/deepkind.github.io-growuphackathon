---
import type { HomeContent } from '../lib/types';

interface Props {
  cookie: HomeContent['cookie'];
}

const { cookie } = Astro.props;
---

<div class="cookie-banner" id="cookie-banner" role="region" aria-label="Informacja o plikach cookies" hidden>
  <p class="cookie-banner__text">{cookie.text}</p>
  <button type="button" class="cookie-banner__accept" id="cookie-accept">{cookie.accept}</button>
</div>

<style>
  .cookie-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-4);
    font-size: 0.875rem;
    color: var(--c-gray-300);
    background: color-mix(in oklch, var(--c-cookie) 92%, transparent);
    border-top: 1px solid color-mix(in oklch, var(--c-lime-500) 20%, transparent);
    backdrop-filter: blur(20px);
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-banner__text {
    text-align: center;
    max-width: 56rem;
  }
  .cookie-banner__accept {
    flex-shrink: 0;
    border: 0;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-pill);
    color: var(--c-ink-deep);
    background: var(--c-lime-500);
    transition: background 0.2s var(--ease-out);
  }
  .cookie-banner__accept:hover {
    background: var(--c-lime-400);
  }

  @media (min-width: 768px) {
    .cookie-banner {
      flex-direction: row;
    }
    .cookie-banner__text {
      text-align: left;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'growup-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  if (banner && accept) {
    let consented = false;
    try {
      consented = localStorage.getItem(STORAGE_KEY) === 'accepted';
    } catch {
      consented = false;
    }
    if (!consented) {
      banner.hidden = false;
    }
    accept.addEventListener('click', () => {
      banner.hidden = true;
      try {
        localStorage.setItem(STORAGE_KEY, 'accepted');
      } catch {
        // ignore storage failures (private mode); banner simply reappears next visit
      }
    });
  }
</script>
