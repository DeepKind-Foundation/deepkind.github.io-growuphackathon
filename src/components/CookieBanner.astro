---
import type { HomeContent } from '../lib/types';

interface Props {
  cookie: HomeContent['cookie'];
  /** Google Analytics Measurement ID (G-XXXXXXXXXX). Empty/undefined keeps analytics fully disabled — see the script below. */
  gaMeasurementId?: string;
}

const { cookie, gaMeasurementId } = Astro.props;
---

<div
  class="cookie-banner"
  id="cookie-banner"
  role="region"
  aria-label="Informacja o plikach cookies"
  data-ga-id={gaMeasurementId}
  hidden
>
  <p class="cookie-banner__text">{cookie.text}</p>
  <div class="cookie-banner__actions">
    <button type="button" class="cookie-banner__decline" id="cookie-decline">{cookie.decline}</button>
    <button type="button" class="cookie-banner__accept" id="cookie-accept">{cookie.accept}</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-4);
    font-size: 0.875rem;
    color: var(--c-gray-300);
    background: color-mix(in oklch, var(--c-cookie) 92%, transparent);
    border-top: 1px solid color-mix(in oklch, var(--c-lime-500) 20%, transparent);
    backdrop-filter: blur(20px);
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-banner__text {
    text-align: center;
    max-width: 56rem;
  }
  .cookie-banner__actions {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-3);
  }
  .cookie-banner__accept,
  .cookie-banner__decline {
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-pill);
    transition: background 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }
  .cookie-banner__decline {
    border: 1px solid color-mix(in oklch, var(--c-white) 25%, transparent);
    background: transparent;
    color: var(--c-gray-300);
  }
  .cookie-banner__decline:hover {
    background: color-mix(in oklch, var(--c-white) 8%, transparent);
  }
  .cookie-banner__accept {
    border: 0;
    color: var(--c-ink-deep);
    background: var(--c-lime-500);
  }
  .cookie-banner__accept:hover {
    background: var(--c-lime-400);
  }

  @media (min-width: 768px) {
    .cookie-banner {
      flex-direction: row;
    }
    .cookie-banner__text {
      text-align: left;
    }
  }
</style>

<style is:global>
  body {
    transition: padding-bottom 0.25s var(--ease-out);
  }
</style>

<script>
  declare global {
    interface Window {
      dataLayer: unknown[];
    }
  }

  const STORAGE_KEY = 'growup-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  const decline = document.getElementById('cookie-decline');

  function loadAnalytics(measurementId: string): void {
    if (window.location.hostname !== 'growuphackathon.pl') return;
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer ?? [];
    function gtag(...args: unknown[]) {
      window.dataLayer.push(args);
    }
    gtag('js', new Date());
    gtag('config', measurementId);
  }

  if (banner && accept && decline) {
    let consent: string | null = null;
    try {
      consent = localStorage.getItem(STORAGE_KEY);
    } catch {
      consent = null;
    }

    const gaId = banner.dataset.gaId;
    if (consent === 'accepted' && gaId) {
      loadAnalytics(gaId);
    }

    if (consent !== 'accepted' && consent !== 'declined') {
      banner.hidden = false;
      const reserveSpace = () => {
        document.body.style.paddingBottom = `${banner.offsetHeight}px`;
      };
      reserveSpace();
      new ResizeObserver(reserveSpace).observe(banner);
    }

    const dismiss = (value: 'accepted' | 'declined') => {
      banner.hidden = true;
      document.body.style.paddingBottom = '';
      try {
        localStorage.setItem(STORAGE_KEY, value);
      } catch {
        /* empty */
      }
    };

    accept.addEventListener('click', () => {
      dismiss('accepted');
      if (gaId) loadAnalytics(gaId);
    });

    decline.addEventListener('click', () => {
      dismiss('declined');
    });
  }
</script>
