---
interface Props {
  opacity?: number;
}
const { opacity = 0.08 } = Astro.props;
---
<div class="col-hatch" aria-hidden="true"></div>

<style define:vars={{ hatchOp: opacity }}>
  .col-hatch {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--hatchOp);
    background-image: repeating-linear-gradient(
      45deg,
      var(--c-ink) 0px,
      var(--c-ink) 0.75px,
      transparent 0.75px,
      transparent 8px
    );
  }
</style>
