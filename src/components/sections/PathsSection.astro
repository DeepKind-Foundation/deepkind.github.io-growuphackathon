---
import type { HomeContent } from '../../lib/types';
import { Icon } from 'astro-icon/components';

interface Props {
  paths: HomeContent['paths'];
}

const { paths } = Astro.props;

type Kind = 'quote' | 'normal';

function bodyBlocks(description: string): { text: string; kind: Kind }[] {
  return description
    .split('\n\n')
    .map((block) => block.trim())
    .filter(Boolean)
    .slice(1) // drop the leading question — it lives in the card head
    .map((text) => ({
      text,
      kind: text.startsWith('„') || text.startsWith('"') ? ('quote' as const) : ('normal' as const),
    }));
}

const items = paths.items.map((item) => {
  const question = item.description.split('\n\n')[0].trim();
  return { ...item, question, blocks: bodyBlocks(item.description) };
});
---

<section id="sciezki" class="section paths">
  <div class="paths__bg" aria-hidden="true"></div>
  <div class="container container--md paths__inner">
    <header class="paths__header reveal">
      <h2 class="section-title paths__title">
        {paths.titleLead} <span class="text-gradient">{paths.titleAccent}</span>
      </h2>
      <p class="paths__intro">{paths.intro}</p>
    </header>

    <div class="paths__list reveal">
      {
        items.map((item) => (
          <details class="paths__card puzzle-block">
            <summary class="paths__summary">
              <span class="paths__icon icon-tile">
                <Icon name={`ph:${item.icon.replace(/^ph-/, '')}-duotone`} aria-hidden="true" />
              </span>
              <span class="paths__head">
                <h3 class="paths__name">{item.title}</h3>
                <p class="paths__question">{item.question}</p>
              </span>
              <Icon name="ph:caret-down-bold" class="paths__caret" aria-hidden="true" />
            </summary>
            <div class="paths__content">
              {item.blocks.map((block) =>
                block.kind === 'quote' ? (
                  <p class="paths__quote">{block.text}</p>
                ) : (
                  <p class="paths__text">{block.text}</p>
                ),
              )}
            </div>
          </details>
        ))
      }
    </div>
    <p class="paths__hint" aria-hidden="true">Przesuń, aby zobaczyć więcej ścieżek →</p>
  </div>
</section>

<style>
  .paths {
    overflow: hidden;
  }
  .paths__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 20% 20%, color-mix(in oklch, var(--c-purple-vivid) 18%, transparent), transparent 45%),
      radial-gradient(circle at 80% 75%, color-mix(in oklch, var(--c-violet-500) 14%, transparent), transparent 40%);
  }
  .paths__inner {
    position: relative;
    z-index: 1;
  }
  .paths__header {
    text-align: center;
    margin-bottom: var(--space-16);
  }
  .paths__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin-bottom: var(--space-4);
  }
  .paths__intro {
    color: var(--c-slate-300);
  }

  /* Mobile: horizontal carousel */
  .paths__list {
    display: flex;
    gap: var(--space-4);
    align-items: start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-4);
    padding-bottom: var(--space-4);
    margin-inline: calc(var(--space-4) * -1);
    padding-inline: var(--space-4);
  }
  .paths__card {
    flex: 0 0 82%;
    scroll-snap-align: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .paths__hint {
    margin-top: var(--space-4);
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-slate-400);
  }

  .paths__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    cursor: pointer;
    list-style: none;
  }
  .paths__summary::-webkit-details-marker {
    display: none;
  }
  .paths__icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
    font-size: 1.625rem;
    color: var(--c-lime-light);
    background: color-mix(in oklch, var(--c-lime-500) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--c-lime-500) 30%, transparent);
  }
  .paths__name {
    font-size: 1.25rem;
    color: var(--c-white);
    line-height: 1.15;
    margin-bottom: var(--space-1);
  }
  .paths__question {
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--c-purple-300);
    font-weight: 600;
  }
  .paths__caret {
    font-size: 1.125rem;
    color: var(--c-slate-400);
    transition: transform 0.25s var(--ease-out);
  }
  .paths__card[open] .paths__caret {
    transform: rotate(180deg);
  }

  .paths__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0 var(--space-6) var(--space-6);
    border-top: 1px solid color-mix(in oklch, var(--c-white) 8%, transparent);
    padding-top: var(--space-5);
  }
  .paths__quote {
    white-space: pre-line;
    font-style: italic;
    line-height: 1.7;
    color: var(--c-gray-300);
    border-left: 4px solid var(--c-lavender);
    padding: var(--space-2) var(--space-4);
    background: color-mix(in oklch, var(--c-white) 3%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .paths__text {
    white-space: pre-line;
    line-height: 1.7;
    color: var(--c-gray-300);
    font-size: 0.95rem;
  }

  /* Desktop: grid of cards, no carousel */
  @media (min-width: 768px) {
    .paths__list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-6);
      overflow: visible;
      align-items: start;
      margin-inline: 0;
      padding-inline: 0;
      padding-bottom: 0;
    }
    .paths__card {
      flex: initial;
    }
    .paths__hint {
      display: none;
    }
  }
</style>
