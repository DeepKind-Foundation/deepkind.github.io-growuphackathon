---
import type { HomeContent } from '../../lib/types';
import { Icon } from 'astro-icon/components';

interface Props {
  faq: HomeContent['faq'];
}

const { faq } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const faqSchemaSafe = JSON.stringify(faqSchema).replace(/</g, '\\u003c');
---

<section id="faq" class="section faq">
  <div class="faq__bg" aria-hidden="true"></div>
  <div class="container container--md faq__inner">
    <header class="faq__header reveal">
      <h2 class="section-title faq__title">
        {faq.titleLead} <span class="text-gradient">{faq.titleAccent}</span>
      </h2>
      <p class="faq__intro">{faq.intro}</p>
    </header>

    <div class="faq__list">
      {
        faq.items.map((item) => (
          <details class="faq__item puzzle-block">
            <summary class="faq__summary">
              <span class="faq__question">{item.question}</span>
              <Icon name="ph:caret-down-bold" class="faq__caret" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={faqSchemaSafe} />

<style>
  .faq {
    overflow: hidden;
  }
  .faq__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 80% 20%, color-mix(in oklch, var(--c-violet-500) 14%, transparent), transparent 45%),
      radial-gradient(circle at 10% 80%, color-mix(in oklch, var(--c-purple-vivid) 12%, transparent), transparent 50%);
  }
  .faq__inner {
    position: relative;
    z-index: 1;
  }
  .faq__header {
    text-align: center;
    margin-bottom: var(--space-16);
  }
  .faq__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin-bottom: var(--space-4);
  }
  .faq__intro {
    color: var(--c-slate-400);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .faq__item {
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    list-style: none;
    background: transparent;
  }
  .faq__summary::-webkit-details-marker {
    display: none;
  }
  .faq__question {
    font-size: 1rem;
    font-weight: 700;
    color: var(--c-white);
  }
  .faq__caret {
    flex-shrink: 0;
    font-size: 1.5rem;
    color: var(--c-lime-400);
    transition: transform 0.3s var(--ease-out);
  }
  .faq__item[open] .faq__caret {
    transform: rotate(180deg);
  }
  .faq__answer {
    padding: var(--space-6);
    border-top: 1px solid color-mix(in oklch, var(--c-white) 10%, transparent);
    background: color-mix(in oklch, var(--c-white) 2%, transparent);
  }
  .faq__answer p {
    line-height: 1.7;
    color: var(--c-gray-300);
  }

  @media (min-width: 768px) {
    .faq__summary {
      padding: var(--space-6) var(--space-8);
    }
    .faq__question {
      font-size: 1.125rem;
    }
    .faq__answer {
      padding: var(--space-6) var(--space-8);
    }
  }
</style>
