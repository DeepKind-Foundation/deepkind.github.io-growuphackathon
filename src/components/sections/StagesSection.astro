---
import type { HomeContent } from '../../lib/types';
import { Icon } from 'astro-icon/components';

interface Props {
  stages: HomeContent['stages'];
}

const { stages } = Astro.props;

// Accent per step: purple family building up to a lime finale (the highlighted final node).
const STAGE_ACCENTS = [
  'var(--c-purple-light)',
  'var(--c-violet-500)',
  'var(--c-purple-400)',
  'var(--c-lime-400)',
];

const items = stages.items.map((item, index) => ({
  ...item,
  accent: STAGE_ACCENTS[index % STAGE_ACCENTS.length],
  finale: index === stages.items.length - 1,
}));
---

<section id="etapy" class="section">
  <div class="container container--md stages__shell section-shell reveal">
    <header class="stages__header">
      <h2 class="section-title stages__title">
        {stages.titleLead} <span class="text-gradient">{stages.titleAccent}</span>
      </h2>
      <p class="stages__intro">{stages.intro}</p>
    </header>

    <ol class="stages__timeline" style={`--count: ${items.length}`}>
      {
        items.map((item) => (
          <li
            class={`stages__step${item.finale ? ' stages__step--finale' : ''}`}
            style={`--accent: ${item.accent}`}
          >
            <div class="stages__node">
              <span class="stages__dot">
                {item.finale ? <Icon name="ph:trophy-fill" aria-hidden="true" /> : item.step}
              </span>
            </div>

            <details class="stages__card">
              <summary class="stages__summary">
                <span class="stages__date">{item.date}</span>
                <h3 class="stages__name">{item.title}</h3>
                <p class="stages__what">{item.what}</p>
                <span class="stages__toggle">
                  Co Cię czeka
                  <Icon name="ph:caret-down-bold" aria-hidden="true" />
                </span>
              </summary>
              <ul class="stages__list">
                {item.expect.map((entry) => (
                  <li>
                    <Icon name="ph:check-circle-fill" aria-hidden="true" />
                    <span>{entry}</span>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .stages__shell {
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-6);
  }
  .stages__header {
    text-align: center;
    margin-bottom: var(--space-16);
  }
  .stages__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin-bottom: var(--space-4);
  }
  .stages__intro {
    color: var(--c-slate-400);
    font-size: 1rem;
  }

  /* Mobile: vertical timeline */
  .stages__timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .stages__timeline::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    bottom: 1.75rem;
    left: 1.75rem;
    width: 2px;
    background: linear-gradient(180deg in oklch, var(--c-purple-vivid), var(--c-lime-400));
    opacity: 0.45;
  }
  .stages__step {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .stages__node {
    display: flex;
    justify-content: center;
  }
  .stages__dot {
    position: relative;
    z-index: 1;
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1rem;
    color: var(--c-ink-deep);
    background: var(--accent);
    box-shadow: 0 0 20px color-mix(in oklch, var(--accent) 35%, transparent);
  }
  .stages__step--finale .stages__dot {
    width: 4.25rem;
    height: 4.25rem;
    font-size: 1.5rem;
    margin-left: -0.375rem;
    box-shadow: 0 0 34px color-mix(in oklch, var(--accent) 55%, transparent);
  }

  .stages__card {
    border: 1px solid color-mix(in oklch, var(--c-white) 8%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--c-bg-2) 55%, transparent);
    padding: var(--space-5);
  }
  .stages__step--finale .stages__card {
    border-color: color-mix(in oklch, var(--c-lime-400) 45%, transparent);
    background: color-mix(in oklch, var(--c-lime-500) 9%, transparent);
  }
  .stages__summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    cursor: pointer;
    list-style: none;
  }
  .stages__summary::-webkit-details-marker {
    display: none;
  }
  .stages__date {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .stages__name {
    font-size: 1.125rem;
    color: var(--c-white);
    line-height: 1.15;
  }
  .stages__step--finale .stages__name {
    font-size: 1.375rem;
  }
  .stages__what {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--c-gray-400);
  }
  .stages__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-lavender);
  }
  .stages__toggle i {
    transition: transform 0.25s var(--ease-out);
  }
  .stages__card[open] .stages__toggle i {
    transform: rotate(180deg);
  }
  .stages__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in oklch, var(--c-white) 8%, transparent);
  }
  .stages__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--c-gray-300);
  }
  .stages__list i {
    color: var(--accent);
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  /* Desktop: horizontal timeline */
  @media (min-width: 900px) {
    .stages__timeline {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--space-6);
      align-items: stretch;
    }
    .stages__timeline::before {
      top: 1.75rem;
      left: calc(50% / var(--count));
      right: calc(50% / var(--count));
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg in oklch, var(--c-purple-vivid), var(--c-lime-400));
    }
    .stages__step {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      justify-items: center;
      text-align: center;
      gap: var(--space-5);
    }
    .stages__step--finale .stages__dot {
      margin-left: 0;
    }
    .stages__card {
      width: 100%;
      height: 100%;
      text-align: left;
      display: flex;
      flex-direction: column;
    }
    .stages__summary {
      flex: 1 1 auto;
    }
    .stages__toggle {
      margin-top: auto;
    }
  }
</style>
