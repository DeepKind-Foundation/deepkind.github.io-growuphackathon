---
import type { HomeContent } from '../../lib/types';

interface Props {
  stages: HomeContent['stages'];
}

const { stages } = Astro.props;
---

<section id="etapy" class="section">
  <div class="container container--md">
    <div class="section-label" aria-hidden="true">03 / Etapy programu</div>

    <header class="stages__header reveal">
      <h2 class="section-title">
        {stages.titleLead} <span class="text-accent">{stages.titleAccent}</span>
      </h2>
      <p class="stages__intro">{stages.intro}</p>
    </header>

    <div class="stages__grid">
      {
        stages.items.map((item) => (
          <article class="stages__card card reveal">
            <div class="stages__card-head">
              <span class="stages__step">{item.step}</span>
              <span class="stages__date">{item.date}</span>
            </div>

            <div class="stages__card-icon">
              <i class={`ph-duotone ${item.icon}`} aria-hidden="true" />
            </div>

            <h3 class="stages__name">{item.title}</h3>
            <p class="stages__what">{item.what}</p>

            <ul class="stages__list">
              {item.expect.map((entry) => (
                <li>
                  <span class="stages__check" aria-hidden="true">—</span>
                  {entry}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stages__header {
    margin-bottom: var(--space-12);
  }
  .stages__intro {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    color: var(--c-ink-3);
  }

  .stages__grid {
    display: grid;
    gap: var(--space-4);
  }

  .stages__card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stages__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .stages__step {
    font-family: var(--font-body);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-red);
  }

  .stages__date {
    font-family: var(--font-body);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--c-ink-3);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-sm);
  }

  .stages__card-icon {
    font-size: 1.75rem;
    color: var(--c-ink-3);
  }

  .stages__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--c-ink);
    line-height: 1.2;
  }

  .stages__what {
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--c-ink-2);
  }

  .stages__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--c-rule);
    margin-top: auto;
  }
  .stages__list li {
    display: flex;
    gap: var(--space-3);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--c-ink-2);
  }
  .stages__check {
    color: var(--c-red);
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .stages__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stages__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
