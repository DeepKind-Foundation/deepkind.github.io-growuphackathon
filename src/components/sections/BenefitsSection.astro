---
import type { HomeContent } from '../../lib/types';
import { safeHref } from '../../lib/url';
import SectionNoise from '../SectionNoise.astro';

interface Props {
  benefits: HomeContent['benefits'];
  waitlistUrl: string;
}

const { benefits, waitlistUrl } = Astro.props;
---

<section id="nagrody" class="section benefits-section">
  <div class="container">
    <div class="section-label" aria-hidden="true">04 / Co zdobywasz</div>

    <div class="benefits__grid reveal">
      <div class="benefits__title-col">
        <h2 class="section-title">
          {benefits.titleLead}<br /><span class="text-accent">{benefits.titleAccent}</span>
        </h2>
      </div>

      <div class="benefits__list-col">
        <ul class="benefits__list">
          {
            benefits.items.map((item) => (
              <li class="benefits__item">
                <span class="benefits__dash" aria-hidden="true">—</span>
                <p>
                  <strong>{item.bold}</strong>{' '}{item.rest}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="benefits__awards card reveal">
      <SectionNoise opacity={0.10} />
      <div class="benefits__awards-body">
        <h3 class="benefits__awards-title">{benefits.awardsTitle}</h3>
      </div>
      <ul class="benefits__awards-list">
        {
          benefits.awards.map((award) => (
            <li class="benefits__award">
              <span class="benefits__award-icon">
                <i class={`ph-bold ${award.icon}`} aria-hidden="true" />
              </span>
              <div>
                <h4 class="benefits__award-name">{award.title}</h4>
                <p class="benefits__award-desc">{award.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="benefits__cta">
      <a
        class="btn-primary btn-primary--lg"
        href={safeHref(waitlistUrl)}
        target="_blank"
        rel="noopener noreferrer"
      >
        {benefits.ctaLabel}
        <i class="ph-bold ph-paper-plane-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<style>
  .benefits-section {
    position: relative;
    isolation: isolate;
  }
  .benefits__grid {
    display: grid;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
    position: relative;
    z-index: 1;
  }

  .benefits__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .benefits__item {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--c-ink-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--c-rule);
  }
  .benefits__item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .benefits__dash {
    color: var(--c-red);
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
  }
  .benefits__item strong {
    color: var(--c-ink);
    font-weight: 600;
  }

  .benefits__awards {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-8);
    margin-bottom: var(--space-16);
    border-left: 4px solid var(--c-yellow);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .benefits__awards-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.875rem);
    font-weight: 600;
    color: var(--c-ink);
    white-space: pre-line;
    line-height: 1.2;
  }

  .benefits__awards-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .benefits__award {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--c-rule);
  }
  .benefits__award:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .benefits__award-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.125rem;
    color: var(--c-red);
    border: 1px solid color-mix(in oklch, var(--c-red) 28%, transparent);
    border-radius: var(--radius-sm);
  }
  .benefits__award-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--c-ink);
    margin-bottom: var(--space-1);
  }
  .benefits__award-desc {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--c-ink-2);
  }

  .benefits__cta {
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 900px) {
    .benefits__grid {
      grid-template-columns: 2fr 3fr;
      align-items: start;
    }
    .benefits__awards {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      padding: var(--space-12);
    }
  }
</style>
