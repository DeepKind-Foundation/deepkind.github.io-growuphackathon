---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { getMentors } from '../../lib/mentors';

// Mentors are sourced from src/data/mentors.csv (see src/lib/mentors.ts), not
// Keystatic — the roster is easiest for organizers to maintain as a spreadsheet
// export. Photos live at public/images/mentors/{index}.png.
const mentors = getMentors().map((mentor) => ({
  ...mentor,
  hasPhoto: existsSync(path.join(process.cwd(), 'public', mentor.image)),
  initials: mentor.name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join(''),
}));
---

{
  mentors.length > 0 && (
    <section id="mentorzy" class="section mentors">
      <div class="container container--md mentors__inner section-shell reveal">
        <h2 class="section-title mentors__title">
          Poznaj <span class="text-gradient">mentorów</span>
        </h2>

        <div class="mentors__grid">
          {mentors.map((mentor) => (
            <div class="mentors__card puzzle-block">
              <div class="mentors__photo">
                {mentor.hasPhoto ? (
                  <img src={mentor.image} alt={mentor.name} loading="lazy" />
                ) : (
                  <span class="mentors__initials" aria-hidden="true">
                    {mentor.initials}
                  </span>
                )}
              </div>
              <h3 class="mentors__name">{mentor.name}</h3>
              {mentor.role && <p class="mentors__role">{mentor.role}</p>}
              {mentor.bio && <p class="mentors__bio">{mentor.bio}</p>}
              {mentor.linkedin && (
                <a class="mentors__link" href={mentor.linkedin} target="_blank" rel="noopener noreferrer">
                  LinkedIn
                  <i class="ph-bold ph-arrow-up-right" aria-hidden="true" />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .mentors__inner {
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-6);
  }
  .mentors__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .mentors__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  .mentors__card {
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mentors__photo {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: var(--radius-pill);
    overflow: hidden;
    margin-bottom: var(--space-4);
    background: color-mix(in oklch, var(--c-purple-vivid) 18%, transparent);
    border: 1px solid color-mix(in oklch, var(--c-white) 12%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mentors__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mentors__initials {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--c-lime-light);
  }

  .mentors__name {
    font-size: 1.125rem;
    color: var(--c-white);
  }
  .mentors__role {
    margin-top: var(--space-1);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-lime-light);
  }
  .mentors__bio {
    margin-top: var(--space-3);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--c-gray-400);
  }
  .mentors__link {
    margin-top: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--c-slate-200);
    transition: color 0.2s var(--ease-out);
  }
  .mentors__link:hover {
    color: var(--c-lavender);
  }

  @media (min-width: 640px) {
    .mentors__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .mentors__inner {
      padding: var(--space-16) var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .mentors__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
