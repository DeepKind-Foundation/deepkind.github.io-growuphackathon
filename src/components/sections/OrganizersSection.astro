---
import type { HomeContent } from '../../lib/types';
import ColumnHatch from '../ColumnHatch.astro';

interface Props {
  organizers: HomeContent['organizers'];
}

const { organizers } = Astro.props;
---

<section id="organizator" class="section organizers-section">
  <div class="container container--md">
    <div class="section-label" aria-hidden="true">06 / Organizatorzy</div>

    <div class="organizers__blocks">
      {
        organizers.blocks.map((block) => (
          <div class="organizers__block reveal">
            <div class="organizers__aside">
              <ColumnHatch opacity={0.10} />
              <h2 class="organizers__name">
                {block.accentFirst ? (
                  <>
                    <span class="text-accent">{block.nameAccent}</span>{' '}
                    <span>{block.nameLead}</span>
                  </>
                ) : (
                  <>
                    <span>{block.nameLead}</span>{' '}
                    <span class="text-accent">{block.nameAccent}</span>
                  </>
                )}
              </h2>
              {block.subtitle && (
                <p class="organizers__subtitle">{block.subtitle}</p>
              )}
              <span class="organizers__rule" aria-hidden="true" />
            </div>

            <div class="organizers__body">
              {block.paragraphs.map((paragraph) => (
                <p class={`organizers__para organizers__para--${paragraph.variant}`}>
                  {paragraph.text}
                </p>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .organizers-section {
    position: relative;
  }

  .organizers__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    position: relative;
    z-index: 1;
  }

  .organizers__aside {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .organizers__block {
    display: grid;
    gap: var(--space-10);
    padding-bottom: var(--space-20);
    border-bottom: 1px solid var(--c-rule);
  }
  .organizers__block:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .organizers__name {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--c-ink);
    line-height: 1.1;
  }

  .organizers__subtitle {
    margin-top: var(--space-3);
    font-size: 0.75rem;
    color: var(--c-ink-3);
    font-family: var(--font-body);
  }

  .organizers__rule {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: var(--space-5);
    background: var(--c-red);
    position: relative;
  }
  .organizers__rule::after {
    content: '';
    position: absolute;
    right: -5px;
    top: -2px;
    width: 6px;
    height: 6px;
    background: var(--c-yellow);
  }

  .organizers__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .organizers__para {
    font-size: 0.875rem;
    line-height: 1.85;
    color: var(--c-ink-2);
  }
  .organizers__para--note {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--c-ink-3);
    padding-left: var(--space-4);
    border-left: 1px solid var(--c-rule);
  }
  .organizers__para--highlight {
    font-weight: 600;
    color: var(--c-ink);
  }

  @media (min-width: 768px) {
    .organizers__block {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }
</style>
