---
import type { HomeContent } from '../../lib/types';
import { safeHref } from '../../lib/url';

interface Props {
  partners: HomeContent['partners'];
}

const { partners } = Astro.props;
const oddBenefits = partners.benefits.length % 2 !== 0;

// Fixed category order; heading shown above each row. Category is chosen per logo in Keystatic.
const CATEGORIES = [
  { key: 'program', heading: 'Partnerzy programu' },
  { key: 'community', heading: 'Partnerzy społeczności' },
  { key: 'patron', heading: 'Patroni honorowi i medialni' },
] as const;

const logos = partners.logos.filter((logo) => logo.image);
const logoRows = CATEGORIES.map((cat) => ({
  heading: cat.heading,
  logos: logos.filter((logo) => logo.category === cat.key),
})).filter((row) => row.logos.length > 0);
---

<section id="partnerzy" class="section partners">
  <div class="partners__bg" aria-hidden="true"></div>
  <div class="container container--md partners__inner">
    {
      logoRows.length > 0 && (
        <div class="partners__panel section-shell reveal">
          <h2 class="section-title partners__title">
            {partners.partnersTitleLead} <span class="text-gradient">{partners.partnersTitleAccent}</span>
          </h2>
          <div class="partners__tiers">
            {logoRows.map((row) => (
              <div class="partners__tier">
                <h3 class="partners__tier-heading">{row.heading}</h3>
                <div class="partners__logos">
                  {row.logos.map((logo) => (
                    <div class="partners__logo">
                      <img src={logo.image} alt={logo.alt} loading="lazy" />
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="partners__panel section-shell reveal">
      <header class="partners__become-head">
        <h2 class="section-title partners__title">
          {partners.becomeTitleLead} <span class="text-gradient">{partners.becomeTitleAccent}</span>
        </h2>
        <p class="partners__become-intro">{partners.becomeIntro}</p>
      </header>

      <div class="partners__stats">
        {
          partners.stats.map((stat) => (
            <div class="partners__stat puzzle-block">
              <div class="partners__stat-value text-gradient-lime" data-countup>{stat.value}</div>
              <div class="partners__stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>

      <ul class={`partners__benefits${oddBenefits ? ' partners__benefits--odd' : ''}`}>
        {
          partners.benefits.map((benefit) => (
            <li class="partners__benefit puzzle-block">
              <span class="partners__benefit-icon icon-tile">
                <i class={`ph-duotone ${benefit.icon}`} aria-hidden="true" />
              </span>
              <div>
                <h4 class="partners__benefit-title">{benefit.title}</h4>
                <p class="partners__benefit-desc">{benefit.description}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="partners__cta">
        <a class="btn-gradient btn-gradient--md" href={safeHref(partners.ctaMailto)}>
          {partners.ctaLabel}
          <i class="ph-bold ph-envelope-simple-open" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .partners {
    overflow: hidden;
  }
  .partners__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 20% 30%, color-mix(in oklch, var(--c-purple-vivid) 12%, transparent), transparent 50%),
      radial-gradient(circle at 80% 70%, color-mix(in oklch, var(--c-violet-500) 12%, transparent), transparent 50%);
  }
  .partners__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .partners__panel {
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-6);
  }
  .partners__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .partners__tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .partners__tier-heading {
    font-size: 1rem;
    text-align: center;
    color: var(--c-slate-400);
    margin-bottom: var(--space-6);
  }

  .partners__logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-12);
  }
  .partners__logo {
    height: 5rem;
    min-width: 10rem;
    padding: var(--space-3) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .partners__logo:hover {
    border-color: color-mix(in oklch, var(--c-lime-400) 45%, transparent);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-3px);
  }
  .partners__logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .partners__become-head {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  .partners__become-head .partners__title {
    margin-bottom: var(--space-4);
  }
  .partners__become-intro {
    max-width: 36rem;
    margin-inline: auto;
    font-size: 1rem;
    color: var(--c-slate-400);
  }

  .partners__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-16);
  }
  @media (min-width: 480px) {
    .partners__stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .partners__stat {
    border-radius: var(--radius-md);
    padding: var(--space-5);
    text-align: center;
  }
  .partners__stat-value {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 900;
    margin-bottom: var(--space-1);
  }
  .partners__stat-label {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--c-slate-400);
  }

  .partners__benefits {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }
  .partners__benefit {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }
  .partners__benefit-icon {
    margin-top: 0.15rem;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    font-size: 1.5rem;
    color: var(--c-lime-light);
    background: color-mix(in oklch, var(--c-lime-500) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--c-lime-500) 30%, transparent);
  }
  .partners__benefit-title {
    color: var(--c-white);
    margin-bottom: var(--space-1);
  }
  .partners__benefit-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--c-gray-400);
  }

  .partners__cta {
    text-align: center;
  }

  @media (min-width: 768px) {
    .partners__panel {
      padding: var(--space-12) var(--space-10);
    }
    .partners__logos {
      gap: var(--space-20);
    }
    .partners__benefits {
      grid-template-columns: repeat(2, 1fr);
    }
    .partners__benefits--odd .partners__benefit:last-child {
      grid-column: span 2;
      max-width: 32rem;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
