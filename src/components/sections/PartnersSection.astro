---
import type { HomeContent } from '../../lib/types';
import { safeHref } from '../../lib/url';
import SectionNoise from '../SectionNoise.astro';

interface Props {
  partners: HomeContent['partners'];
}

const { partners } = Astro.props;
const oddBenefits = partners.benefits.length % 2 !== 0;
---

<section id="partnerzy" class="section partners-section">
  <SectionNoise opacity={0.03} />
  <div class="container container--md">
    <div class="section-label" aria-hidden="true">07 / Partnerzy</div>

    <!-- Current partners -->
    <div class="partners__current reveal">
      <h2 class="section-title">
        {partners.partnersTitleLead} <span class="text-accent">{partners.partnersTitleAccent}</span>
      </h2>
      <div class="partners__logos">
        {
          partners.logos.map((logo) => (
            <div class="partners__logo">
              <img src={logo.image} alt={logo.alt} loading="lazy" />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Become a partner -->
    <div class="partners__become reveal">
      <div class="partners__become-head">
        <h2 class="section-title">
          {partners.becomeTitleLead} <span class="text-accent">{partners.becomeTitleAccent}</span>
        </h2>
        <p class="partners__become-intro">{partners.becomeIntro}</p>
      </div>

      <div class="partners__stats">
        {
          partners.stats.map((stat) => (
            <div class="partners__stat">
              <div class="partners__stat-value">{stat.value}</div>
              <div class="partners__stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>

      <ul class={`partners__benefits${oddBenefits ? ' partners__benefits--odd' : ''}`}>
        {
          partners.benefits.map((benefit) => (
            <li class="partners__benefit card">
              <span class="partners__benefit-icon">
                <i class={`ph-duotone ${benefit.icon}`} aria-hidden="true" />
              </span>
              <div>
                <h4 class="partners__benefit-title">{benefit.title}</h4>
                <p class="partners__benefit-desc">{benefit.description}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="partners__cta">
        <a class="btn-primary btn-primary--md" href={safeHref(partners.ctaMailto)}>
          {partners.ctaLabel}
          <i class="ph-bold ph-envelope-simple-open" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .partners-section {
    position: relative;
    isolation: isolate;
  }

  .partners__current {
    padding-bottom: var(--space-16);
    margin-bottom: var(--space-16);
    border-bottom: 1px solid var(--c-rule);
    position: relative;
    z-index: 1;
  }
  .partners__current::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--c-red);
  }

  .partners__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-10);
    margin-top: var(--space-10);
  }
  .partners__logo {
    height: 5rem;
    display: flex;
    align-items: center;
  }
  .partners__logo img {
    max-height: 100%;
    max-width: 10rem;
    object-fit: contain;
    width: auto;
  }

  .partners__become {
    position: relative;
    z-index: 1;
  }

  .partners__become-head {
    margin-bottom: var(--space-12);
  }
  .partners__become-intro {
    margin-top: var(--space-4);
    font-size: 0.875rem;
    color: var(--c-ink-2);
    max-width: 36rem;
  }

  .partners__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-1);
    margin-bottom: var(--space-12);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .partners__stat {
    padding: var(--space-5) var(--space-4);
    text-align: center;
    border-right: 1px solid var(--c-rule);
    background: var(--c-paper-1);
  }
  .partners__stat:last-child {
    border-right: 0;
  }
  .partners__stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    color: var(--c-red);
    margin-bottom: var(--space-1);
  }
  .partners__stat-label {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    color: var(--c-ink-3);
  }

  .partners__benefits {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }
  .partners__benefit {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-5);
  }
  .partners__benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.125rem;
    color: var(--c-red);
    border: 1px solid color-mix(in oklch, var(--c-red) 28%, transparent);
    border-radius: var(--radius-sm);
  }
  .partners__benefit-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--c-ink);
    margin-bottom: var(--space-1);
  }
  .partners__benefit-desc {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--c-ink-2);
  }

  .partners__cta {
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 768px) {
    .partners__benefits {
      grid-template-columns: repeat(2, 1fr);
    }
    .partners__benefits--odd .partners__benefit:last-child {
      grid-column: span 2;
      max-width: 32rem;
    }
  }
</style>
