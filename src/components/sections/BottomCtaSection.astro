---
import type { HomeContent } from '../../lib/types';
import { safeHref } from '../../lib/url';

interface Props {
  bottomCta: HomeContent['bottomCta'];
  waitlistUrl: string;
}

const { bottomCta, waitlistUrl } = Astro.props;
---

<section class="section bottom-cta">
  <div class="container container--narrow">
    <div class="bottom-cta__inner reveal">
      <h2 class="bottom-cta__title">
        {bottomCta.titleLead} <span class="text-accent">{bottomCta.titleAccent}</span>
      </h2>
      <p class="bottom-cta__text">{bottomCta.text}</p>
      <a
        class="btn-primary btn-primary--lg"
        href={safeHref(waitlistUrl)}
        target="_blank"
        rel="noopener noreferrer"
      >
        {bottomCta.ctaLabel}
        <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<style>
  .bottom-cta__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    padding: var(--space-16) var(--space-8);
    border: 1px solid var(--c-ink);
    border-radius: var(--radius-lg);
  }

  .bottom-cta__title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 5vw, 2.75rem);
    font-weight: 600;
    color: var(--c-ink);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .bottom-cta__text {
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--c-ink-2);
  }

  @media (min-width: 768px) {
    .bottom-cta__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-10);
    }
    .bottom-cta__title {
      flex: 1;
    }
    .bottom-cta__text {
      display: none;
    }
  }
</style>
