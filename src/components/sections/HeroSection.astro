---
import type { HomeContent } from '../../lib/types';
import { safeHref } from '../../lib/url';

interface Props {
  hero: HomeContent['hero'];
  waitlistUrl: string;
}

const { hero, waitlistUrl } = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__bg-art" aria-hidden="true">
    <svg viewBox="0 0 1200 900" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMaxYMid slice">
      <!-- Ascending diagonal band — bold single gesture along the GROWUP ascent axis -->
      <polygon points="-83,843 1217,-16 1283,84 -17,943" class="art-band"/>
    </svg>
  </div>

  <div class="hero__upper">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__wordmark" id="hero-heading">
      {hero.wordmarkLead}<span class="hero__wordmark-accent">{hero.wordmarkAccent}</span>
    </h1>
    <p class="hero__tagline">{hero.taglinePurple} {hero.taglineLime}</p>
  </div>

  <div class="hero__lower">
    <div class="hero__leads">
      <p class="hero__lead">{hero.leadParagraph1}</p>
      <p class="hero__lead">{hero.leadParagraph2}</p>
    </div>
    <div class="hero__actions">
      {
        hero.ctaEnabled ? (
          <a
            class="btn-primary btn-primary--lg"
            href={safeHref(waitlistUrl)}
            target="_blank"
            rel="noopener noreferrer"
          >
            {hero.ctaLabel}
            <i class="ph-bold ph-arrow-right" aria-hidden="true" />
          </a>
        ) : (
          <button class="btn-primary btn-primary--lg" type="button" disabled>
            {hero.ctaLabel}
            <i class="ph-bold ph-arrow-right" aria-hidden="true" />
          </button>
        )
      }
    </div>
  </div>

  <div class="hero__foot" aria-hidden="true">
    <span class="hero__scroll-hint">↓ przewijaj</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(3.5rem + 56px); /* clears fixed header */
    padding-inline: var(--space-6);
    padding-bottom: var(--space-8);
    max-width: var(--container-max);
    margin-inline: auto;
    width: 100%;
  }

  .hero__bg-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .hero__bg-art svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .art-band { fill: var(--c-yellow); opacity: 0.35; }

  .hero__upper {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__eyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    margin-bottom: var(--space-6);
  }

  .hero__wordmark {
    font-family: var(--font-display);
    font-size: clamp(5rem, 17vw, 13.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.87;
    color: var(--c-ink);
    margin-bottom: var(--space-8);
  }

  .hero__wordmark-accent {
    color: var(--c-yellow);
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.8vw, 2rem);
    font-weight: 400;
    font-style: italic;
    color: var(--c-ink-2);
    max-width: 38rem;
  }

  .hero__lower {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-8);
    padding-top: var(--space-12);
    margin-top: var(--space-12);
    border-top: 1px solid var(--c-rule);
  }

  .hero__lead {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--c-ink-2);
  }
  .hero__lead + .hero__lead {
    margin-top: var(--space-4);
  }

  .hero__actions {
    display: flex;
    align-items: flex-end;
  }

  .hero__foot {
    position: relative;
    z-index: 1;
    padding-top: var(--space-8);
    display: flex;
    justify-content: flex-end;
  }

  .hero__scroll-hint {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }

  @media (min-width: 768px) {
    .hero__lower {
      grid-template-columns: 3fr 2fr;
      align-items: end;
    }
  }
</style>
