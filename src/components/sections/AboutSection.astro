---
import type { HomeContent } from '../../lib/types';
import ColumnHatch from '../ColumnHatch.astro';

interface Props {
  about: HomeContent['about'];
}

const { about } = Astro.props;
---

<section id="o-projekcie" class="section about">
  <div class="container about__inner">
    <div class="about__label section-label" aria-hidden="true">01 / O projekcie</div>

    <div class="about__grid reveal">
      <div class="about__title-col">
        <ColumnHatch opacity={0.10} />
        <h2 class="section-title">
          {about.titleLead}<br /><span class="text-accent">{about.titleAccent}</span>
        </h2>
      </div>
      <div class="about__body-col">
        <div class="about__body">
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <blockquote class="about__highlight">
          {about.highlight}
        </blockquote>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    isolation: isolate;
  }

  .about__inner {
    max-width: var(--container-max);
    position: relative;
    z-index: 1;
  }

  .about__grid {
    display: grid;
    gap: var(--space-12);
  }

  .about__title-col {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .about__title-col .section-title {
    line-height: 1.08;
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    font-size: 0.875rem;
    line-height: 1.85;
    color: var(--c-ink-2);
  }

  .about__highlight {
    margin: 0;
    margin-top: var(--space-8);
    padding-left: var(--space-5);
    border-left: 2px solid var(--c-red);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    color: var(--c-ink);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 2fr 3fr;
      gap: 0;
      align-items: start;
    }
    .about__title-col {
      padding-right: var(--space-12);
    }
    .about__body-col {
      border-left: 1px solid var(--c-rule);
      padding-left: var(--space-12);
    }
  }
</style>
