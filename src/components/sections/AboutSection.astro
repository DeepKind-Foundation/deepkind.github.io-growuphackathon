---
import type { HomeContent } from '../../lib/types';

interface Props {
  about: HomeContent['about'];
}

const { about } = Astro.props;

const visibleParagraphs = about.paragraphs.slice(0, 2);
const moreParagraphs = about.paragraphs.slice(2);
const hasMore = moreParagraphs.length > 0 || Boolean(about.highlight);
---

<section id="o-projekcie" class="section section-glow">
  <div class="container container--md about__shell section-shell reveal">
    <div class="about__inner">
      <h2 class="section-title about__title">
        {about.titleLead} <span class="text-gradient">{about.titleAccent}</span>
      </h2>

      <div class="about__body">
        {visibleParagraphs.map((paragraph) => <p>{paragraph}</p>)}

        {
          hasMore && (
            <details class="about__more">
              <summary class="about__more-toggle">
                <span>Czytaj więcej</span>
                <i class="ph-bold ph-caret-down" aria-hidden="true" />
              </summary>
              <div class="about__more-body">
                {moreParagraphs.map((paragraph) => <p>{paragraph}</p>)}
                {about.highlight && <p class="about__highlight">{about.highlight}</p>}
              </div>
            </details>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about__shell {
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-6);
  }
  .about__inner {
    max-width: 56rem;
    margin-inline: auto;
  }
  .about__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    text-align: center;
    margin-bottom: var(--space-8);
    line-height: 1.15;
  }
  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--c-gray-300);
  }
  .about__highlight {
    font-weight: 600;
    color: var(--c-white);
    border-left: 4px solid var(--c-lime-400);
    padding-left: var(--space-4);
  }

  .about__more {
    margin-top: calc(var(--space-6) * -1 + var(--space-2));
  }
  .about__more-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--c-lavender);
    padding: var(--space-2) 0;
    transition: color 0.2s var(--ease-out);
  }
  .about__more-toggle::-webkit-details-marker {
    display: none;
  }
  .about__more-toggle:hover {
    color: var(--c-lime-400);
  }
  .about__more-toggle i {
    transition: transform 0.25s var(--ease-out);
  }
  .about__more[open] .about__more-toggle i {
    transform: rotate(180deg);
  }
  .about__more-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .about__shell {
      padding: var(--space-16) var(--space-10);
    }
  }
</style>
