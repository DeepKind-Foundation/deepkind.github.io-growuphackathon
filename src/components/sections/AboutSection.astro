---
import type { HomeContent } from '../../lib/types';

interface Props {
  about: HomeContent['about'];
}

const { about } = Astro.props;
---

<section id="o-projekcie" class="section section-glow">
  <div class="container about__shell section-shell reveal">
    <div class="about__inner">
      <h2 class="section-title about__title">
        {about.titleLead} <span class="text-gradient">{about.titleAccent}</span>
      </h2>

      <div class="about__body">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="about__highlight">{about.highlight}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about__shell {
    max-width: var(--container-max);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-6);
  }
  .about__inner {
    max-width: 56rem;
    margin-inline: auto;
  }
  .about__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    text-align: center;
    margin-bottom: var(--space-8);
    line-height: 1.15;
  }
  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--c-gray-300);
  }
  .about__highlight {
    font-weight: 600;
    color: var(--c-white);
    border-left: 4px solid var(--c-lime-400);
    padding-left: var(--space-4);
  }

  @media (min-width: 768px) {
    .about__shell {
      padding: var(--space-16) var(--space-10);
    }
  }
</style>
