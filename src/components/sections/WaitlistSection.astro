---
import type { HomeContent } from '../../lib/types';
import { safeHref } from '../../lib/url';

interface Props {
  waitlist: HomeContent['waitlist'];
  waitlistUrl: string;
}

const { waitlist, waitlistUrl } = Astro.props;
---

<section class="section waitlist">
  <div class="container container--narrow waitlist__inner reveal">
    <h2 class="waitlist__title">{waitlist.title}</h2>
    <p class="waitlist__text">{waitlist.text}</p>
    <a class="btn-primary btn-primary--md" href={safeHref(waitlistUrl)} target="_blank" rel="noopener noreferrer">
      {waitlist.ctaLabel}
      <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
    </a>
  </div>
</section>

<style>
  .waitlist__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    padding: var(--space-12) var(--space-8);
    background: var(--c-yellow);
    border-radius: var(--radius-lg);
  }

  .waitlist__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    color: var(--c-yellow-on);
    line-height: 1.1;
  }

  .waitlist__text {
    font-size: 0.8125rem;
    line-height: 1.75;
    color: color-mix(in oklch, var(--c-yellow-on) 70%, transparent);
  }

  .waitlist__inner .btn-primary {
    background: var(--c-yellow-on);
    color: var(--c-yellow);
  }
  .waitlist__inner .btn-primary:hover {
    background: color-mix(in oklch, var(--c-yellow-on) 85%, var(--c-yellow));
  }
</style>
