---
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Add person — GrowUp Admin</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <a class="back" href="/admin">&larr; Back</a>
    <h1>Add mentor, expert or trainer</h1>

    <div class="form-card">
      <form id="form" class="form-layout">
        <div>
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" required />

          <label for="group">Group</label>
          <select id="group" name="group" required>
            <option value="mentors">Mentor</option>
            <option value="experts">Expert</option>
            <option value="trainers">Trainer</option>
          </select>

          <label for="order">Sort order within group</label>
          <input type="number" id="order" name="order" value="0" />

          <label for="role">Role</label>
          <input type="text" id="role" name="role" />

          <label for="bio">Bio</label>
          <textarea id="bio" name="bio"></textarea>

          <label for="linkedin">LinkedIn URL (optional)</label>
          <input type="url" id="linkedin" name="linkedin" />

          <label for="photo">Photo (optional, under 2MB)</label>
          <input type="file" id="photo" name="photo" accept="image/*" />

          <button type="submit">Save &amp; create preview</button>
        </div>

        <div class="form-preview">
          <div class="entry-thumb round empty">
            <img id="photo-preview" alt="" hidden />
          </div>
          <p>Preview</p>
        </div>
      </form>
    </div>

    <div id="result"></div>

    <script>
      import { wireAdminForm, wireImagePreview } from '../../../lib/admin/form-client';
      wireAdminForm('/admin/api/people');
      wireImagePreview('photo', 'photo-preview');
    </script>
  </body>
</html>
