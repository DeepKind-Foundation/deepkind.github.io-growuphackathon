---
import { createInstallationOctokit, getJsonEntry } from '../../../../lib/admin/github';
import { getGitHubAppCredentials, REPO } from '../../../../lib/admin/env';
import { PEOPLE_IMAGES_PATH, type PersonData } from '../../../../lib/admin/types';

export const prerender = false;

const { slug } = Astro.params;
let entry: PersonData | undefined;
let loadError: string | undefined;

try {
  const octokit = createInstallationOctokit(getGitHubAppCredentials());
  const result = await getJsonEntry<PersonData>(octokit, REPO, 'src/content/people', slug!);
  entry = result?.data;
  if (!entry) loadError = `No person found with slug "${slug}".`;
} catch (error) {
  loadError = error instanceof Error ? error.message : 'Unknown error loading person.';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit person — GrowUp Admin</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <a class="back" href="/admin">&larr; Back</a>
    <h1>Edit person</h1>

    {loadError && <div class="error">{loadError}</div>}

    {entry && (
      <form id="form">
        <input type="hidden" name="slug" value={slug} />
        <input type="hidden" name="existingPhoto" value={entry.photo} />

        <label for="name">Full name</label>
        <input type="text" id="name" name="name" required value={entry.name} />

        <label for="group">Group</label>
        <select id="group" name="group" required>
          <option value="mentors" selected={entry.group === 'mentors'}>Mentor</option>
          <option value="experts" selected={entry.group === 'experts'}>Expert</option>
          <option value="trainers" selected={entry.group === 'trainers'}>Trainer</option>
        </select>

        <label for="order">Sort order within group</label>
        <input type="number" id="order" name="order" value={entry.order} />

        <label for="role">Role</label>
        <input type="text" id="role" name="role" value={entry.role} />

        <label for="bio">Bio</label>
        <textarea id="bio" name="bio">{entry.bio}</textarea>

        <label for="linkedin">LinkedIn URL (optional)</label>
        <input type="url" id="linkedin" name="linkedin" value={entry.linkedin} />

        <label for="photo">Replace photo (optional — leave empty to keep current)</label>
        {entry.photo && <img class="current round" src={`${PEOPLE_IMAGES_PATH}${entry.photo}`} alt="Current photo" />}
        <input type="file" id="photo" name="photo" accept="image/*" />

        <button type="submit">Save &amp; create preview</button>
      </form>
    )}

    <div id="result"></div>

    <script>
      import { wireAdminForm } from '../../../../lib/admin/form-client';
      wireAdminForm('/admin/api/people');
    </script>
  </body>
</html>
