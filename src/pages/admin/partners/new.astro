---
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Add partner — GrowUp Admin</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <a class="back" href="/admin">&larr; Back</a>
    <h1>Add partner logo</h1>

    <div class="form-card">
      <form id="form" class="form-layout">
        <div>
          <label for="name">Partner name</label>
          <input type="text" id="name" name="name" required />

          <label for="category">Category</label>
          <select id="category" name="category" required>
            <option value="program">Partnerzy programu</option>
            <option value="community">Partnerzy społeczności</option>
            <option value="patron">Patroni honorowi i medialni</option>
          </select>

          <label for="order">Sort order within category</label>
          <input type="number" id="order" name="order" value="0" />

          <label for="logo">Logo image (SVG or PNG, under 2MB)</label>
          <input type="file" id="logo" name="logo" accept="image/*" required />

          <button type="submit">Save &amp; create preview</button>
        </div>

        <div class="form-preview">
          <div class="entry-thumb empty">
            <img id="logo-preview" alt="" hidden />
          </div>
          <p>Preview</p>
        </div>
      </form>
    </div>

    <div id="result"></div>

    <script>
      import { wireAdminForm, wireImagePreview } from '../../../lib/admin/form-client';
      wireAdminForm('/admin/api/partners');
      wireImagePreview('logo', 'logo-preview');
    </script>
  </body>
</html>
