---
import { createInstallationOctokit, getJsonEntry } from '../../../../lib/admin/github';
import { getGitHubAppCredentials, REPO } from '../../../../lib/admin/env';
import { PARTNER_IMAGES_PATH, type PartnerData } from '../../../../lib/admin/types';

export const prerender = false;

const { slug } = Astro.params;
let entry: PartnerData | undefined;
let loadError: string | undefined;

try {
  const octokit = createInstallationOctokit(getGitHubAppCredentials());
  const result = await getJsonEntry<PartnerData>(octokit, REPO, 'src/content/partners', slug!);
  entry = result?.data;
  if (!entry) loadError = `No partner found with slug "${slug}".`;
} catch (error) {
  loadError = error instanceof Error ? error.message : 'Unknown error loading partner.';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit partner — GrowUp Admin</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <a class="back" href="/admin">&larr; Back</a>
    <h1>Edit partner logo</h1>

    {loadError && <div class="error">{loadError}</div>}

    {entry && (
      <div class="form-card">
        <form id="form" class="form-layout">
          <div>
            <input type="hidden" name="slug" value={slug} />
            <input type="hidden" name="existingLogo" value={entry.logo} />

            <label for="name">Partner name</label>
            <input type="text" id="name" name="name" required value={entry.name} />

            <label for="category">Category</label>
            <select id="category" name="category" required>
              <option value="program" selected={entry.category === 'program'}>Partnerzy programu</option>
              <option value="community" selected={entry.category === 'community'}>Partnerzy społeczności</option>
              <option value="patron" selected={entry.category === 'patron'}>Patroni honorowi i medialni</option>
            </select>

            <label for="order">Sort order within category</label>
            <input type="number" id="order" name="order" value={entry.order} />

            <label for="logo">Replace logo (optional — leave empty to keep current)</label>
            <input type="file" id="logo" name="logo" accept="image/*" />

            <button type="submit">Save &amp; create preview</button>
          </div>

          <div class="form-preview">
            <div class={`entry-thumb ${entry.logo ? '' : 'empty'}`}>
              <img id="logo-preview" alt="" src={entry.logo ? `${PARTNER_IMAGES_PATH}${entry.logo}` : undefined} hidden={!entry.logo} />
            </div>
            <p>Preview</p>
          </div>
        </form>

        <button id="delete" type="button" class="danger" data-slug={slug} data-label={entry.name}>Delete this partner</button>
      </div>
    )}

    <div id="result"></div>

    <script>
      import { wireAdminForm, wireDeleteButton, wireImagePreview } from '../../../../lib/admin/form-client';
      wireAdminForm('/admin/api/partners');
      wireDeleteButton('/admin/api/partners');
      wireImagePreview('logo', 'logo-preview');
    </script>
  </body>
</html>
