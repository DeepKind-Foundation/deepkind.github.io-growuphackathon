---
import { createInstallationOctokit, findOpenPullRequest, getChangedFileCount, listJsonEntries, DEV_BRANCH } from '../../lib/admin/github';
import { getGitHubAppCredentials, getPreviewUrl, REPO } from '../../lib/admin/env';
import { PARTNER_IMAGES_PATH, PEOPLE_IMAGES_PATH, type PartnerData, type PersonData } from '../../lib/admin/types';

export const prerender = false;

let partners: { slug: string; data: PartnerData }[] = [];
let people: { slug: string; data: PersonData }[] = [];
let loadError: string | undefined;
let pendingPr: Awaited<ReturnType<typeof findOpenPullRequest>> | undefined;
let pendingChangeCount = 0;

try {
  const octokit = createInstallationOctokit(getGitHubAppCredentials());
  const [partnerEntries, peopleEntries, devPr] = await Promise.all([
    listJsonEntries<PartnerData>(octokit, REPO, 'src/content/partners'),
    listJsonEntries<PersonData>(octokit, REPO, 'src/content/people'),
    findOpenPullRequest(octokit, REPO, DEV_BRANCH),
  ]);
  partners = partnerEntries.sort((a, b) => a.data.order - b.data.order);
  people = peopleEntries.sort((a, b) => a.data.order - b.data.order);
  pendingPr = devPr;
  if (pendingPr) {
    pendingChangeCount = await getChangedFileCount(octokit, REPO, pendingPr.number);
  }
} catch (error) {
  loadError = error instanceof Error ? error.message : 'Unknown error loading content.';
}

const previewUrl = getPreviewUrl();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>GrowUp Admin</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <h1>GrowUp Admin</h1>

    {loadError && (
      <div class="error">
        Could not load content from GitHub: {loadError}
      </div>
    )}

    {pendingPr && (
      <div class="banner">
        <strong>{pendingChangeCount} file(s) pending.</strong>
        {previewUrl ? (
          <a href={previewUrl} target="_blank" rel="noopener">Open live preview</a>
        ) : (
          <a href={pendingPr.html_url} target="_blank" rel="noopener">View pending PR</a>
        )}
        <button id="publish-all" type="button">Publish all pending changes</button>
      </div>
    )}

    <h2>
      Partner logos
      <a class="button" href="/admin/partners/new" style="float: right;">Add partner</a>
    </h2>
    <table>
      <thead><tr><th>Logo</th><th>Name</th><th>Category</th><th></th></tr></thead>
      <tbody>
        {partners.map((p) => (
          <tr>
            <td>{p.data.logo && <img class="thumb" src={`${PARTNER_IMAGES_PATH}${p.data.logo}`} alt="" />}</td>
            <td>{p.data.name}</td>
            <td>{p.data.category}</td>
            <td><a href={`/admin/partners/${p.slug}/edit`}>Edit</a></td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>
      Mentors, experts &amp; trainers
      <a class="button" href="/admin/people/new" style="float: right;">Add person</a>
    </h2>
    <table>
      <thead><tr><th>Photo</th><th>Name</th><th>Group</th><th></th></tr></thead>
      <tbody>
        {people.map((p) => (
          <tr>
            <td>{p.data.photo && <img class="thumb" src={`${PEOPLE_IMAGES_PATH}${p.data.photo}`} alt="" />}</td>
            <td>{p.data.name}</td>
            <td>{p.data.group}</td>
            <td><a href={`/admin/people/${p.slug}/edit`}>Edit</a></td>
          </tr>
        ))}
      </tbody>
    </table>

    <script>
      import { wirePublishButton } from '../../lib/admin/form-client';
      const btn = document.getElementById('publish-all');
      if (btn) wirePublishButton(btn as HTMLButtonElement);
    </script>
  </body>
</html>
